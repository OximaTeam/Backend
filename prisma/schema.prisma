generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        String   @id @default(uuid())
  username  String
  password  String
  email     String   @unique
  createdAt DateTime @default(now())

  folders   Folders[]
  notes     Notes[]
}

model Folders {
  id       String   @id @default(uuid()) @unique
  name     String
  parentId String?  
  ownerId  String

  owner    Users    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   Folders? @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children Folders[] @relation("FolderToFolder")

  notes    Notes[]
}

model Notes {
  id        String   @id @default(uuid()) @unique
  ownerId   String
  parentId  String?
  name      String
  blocksList String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     Users    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent    Folders? @relation(fields: [parentId], references: [id], onDelete: Cascade)
  blocks    Blocks[]
}

model Blocks {
  id        String    @id @default(uuid()) @unique
  noteId    String
  type      BlockType
  content   Json?
  processed Boolean @default(false)

  note      Notes     @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

enum BlockType {
  paragraph
  heading1
  heading2
  heading3
  heading4
  heading5
  unorderedList
  orderedList
  checkedList
  callout
  quote
  table
  separator
  image
  video
  audio
  file
  code
  math
}